BLENDER_PASSWORD=

# ─── Backend API ───────────────────────────────────────
API_PORT=8100
MCP_PORT=8200

# ─── Paths (relativi al compose, default ok) ──────────
WORKSPACE_DIR=./workspace
CONFIG_DIR=./config